<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\Session;
use App\Http\Controllers\CartController;

class OrderController extends Controller
{
    /**
     * Display the checkout page
     */
    public function create()
    {
        $cart = Session::get('cart', []);
        
        if (empty($cart)) {
            return redirect()->route('home')->with('error', 'Cart is empty!');
        }

        $total = CartController::calculateTotal();

        return view('orders.create', compact('cart', 'total'));
    }

    /**
     * Store the order and create Xendit QRIS payment
     */
    public function store(Request $request)
    {
        $request->validate([
            'total_amount' => 'required|numeric',
        ]);

        $cart = Session::get('cart', []);
        
        if (empty($cart)) {
            return redirect()->route('home')->with('error', 'Cart is empty!');
        }

        $items = array_values($cart);
        $total = $request->input('total_amount');
        $tableNumber = Session::get('table_number', '01');

        // Generate transaction code
        $transactionCode = 'JV' . date('ymdHis') . rand(100, 999);

        // Create Xendit QRIS payment
        $xenditService = new \App\Services\XenditService();
        $result = $xenditService->createQRISPayment([
            'transaction_code' => $transactionCode,
            'amount' => $total,
            'table_number' => $tableNumber,
            'items' => $items,
        ]);

        if (!$result['success']) {
            \Log::error('Xendit Payment Failed', ['result' => $result]);
            return redirect()->back()
                ->with('error', 'Payment gateway error: ' . ($result['error'] ?? 'Unknown error'));
        }

        \Log::info('Xendit Payment Success', [
            'qr_id' => $result['qr_id'] ?? 'null',
            'qr_string' => !empty($result['qr_string']) ? 'exists' : 'empty',
            'is_fallback' => $result['is_fallback'] ?? false
        ]);

        // Generate QR code image from QRIS string
        $qrCodeImage = null;
        if (!empty($result['qr_string'])) {
            $qrCodeImage = $xenditService->generateQRCodeImage($result['qr_string'], 280);
            \Log::info('QR Code Image Generated', [
                'image_size' => strlen($qrCodeImage ?? ''),
                'has_image' => !empty($qrCodeImage)
            ]);
        } else {
            \Log::warning('No QR String from Xendit', [
                'result' => $result
            ]);
        }

        // Store order info in session
        Session::put('pending_order', [
            'transaction_code' => $transactionCode,
            'total_amount' => $total,
            'payment_method' => 'QRIS',
            'items' => $items,
            'status' => 'pending_payment',
            'estimated_time' => '15 Min',
            'qr_id' => $result['qr_id'] ?? null,
            'qr_string' => $result['qr_string'] ?? null,
            'qr_code_image' => $qrCodeImage,
            'invoice_url' => $result['invoice_url'] ?? null,
            'is_fallback' => $result['is_fallback'] ?? false,
            'expiry_date' => $result['expires_at'] ?? now()->addHour()->toIso8601String(),
        ]);

        // Clear cart
        Session::forget('cart');

        // Redirect to payment page
        return redirect()->route('payment.show', ['transaction' => $transactionCode]);
    }

    /**
     * Display order success page
     */
    public function success()
    {
        $order = Session::get('last_order');
        
        if (!$order) {
            return redirect()->route('home')->with('error', 'No order found!');
        }

        return view('orders.success', compact('order'));
    }
}